# Leaderboard results and the interactive masking console both read the
# S3-compatible bucket NiFi uses. Leave these unset to serve demo data and
# disable the console.
ARENA_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
ARENA_S3_ACCESS_KEY_ID=
ARENA_S3_SECRET_ACCESS_KEY=
ARENA_S3_REGION=auto

# Where QA publishes its output. Two document kinds share this prefix: the
# cross-team ranking documents scripts/rank_teams.py writes, flat at
# results/leaderboard-*.json, and the per-team reports beneath them at
# results/<team>/<document-id>/<report>.json. The board is built from the
# former; see evaluation/leaderboard_api/ranking.py.
ARENA_RESULTS_BUCKET=data
ARENA_RESULTS_PREFIX=results

# Which of qa-automation's two independent rankings the board is built from.
# "overlapping" counts a detected span that found the entity but got its
# boundaries wrong; "exact" requires the boundaries too. QA's headline number is
# the overlapping ranking, so that is the default.
ARENA_RANKING_BASIS=overlapping
# Only consider ranking documents from this run mode. "local" documents come
# from a developer running the QA suite against locally served models, and one
# uploaded by accident must never displace a real release evaluation just by
# being newer. Leave empty to consider every mode.
ARENA_LEADERBOARD_MODE=release
# Pin one exact ranking document, e.g.
# results/leaderboard-aggregate-15docs-release.json. Empty means choose
# automatically: most documents scored first, then most recent.
ARENA_LEADERBOARD_KEY=

# The arena's own copies of the ranking documents it has seen, which is what
# lets the board draw a trend at all: qa-automation reuses one key per document
# set, so each run overwrites the previous scores. Off here because it writes to
# the results bucket and a shared dev credential should not fill it by accident.
ARENA_HISTORY_PREFIX=results/history
ARENA_ARCHIVE_RANKINGS=false

# Used only when the board cannot be read; otherwise the masking console takes
# its team from the leaderboard's champion.
ARENA_CHAMPION_FALLBACK_TEAM=berts

# Production key layout, per contracts/masking-api/v1.2 section 8. Uploads go to
# the `source` bucket; NiFi writes masked output and manifests to `destination`.
ARENA_SOURCE_BUCKET=source
ARENA_INCOMING_PREFIX=incoming
# NiFi's ListS3 watches incoming/<team>/requests/. Placeholders: {prefix},
# {team}, {date}, {run_id}, {filename}. Keys must stay flat at this depth:
# every key NiFi has processed is incoming/<team>/requests/<file>.
ARENA_INCOMING_KEY_TEMPLATE={prefix}/{team}/requests/{run_id}-{filename}
ARENA_MASKED_BUCKET=destination
ARENA_MASKED_PREFIX=masked
# Manifests sit beside the masked output; leave empty to reuse ARENA_MASKED_BUCKET.
ARENA_MANIFEST_BUCKET=
ARENA_MANIFEST_PREFIX=manifests

# Every team the API will accept an upload for. Must match the gateway's
# supported teams; runs.py rejects any other team server-side. The team console
# offers all of these, the masking console offers the current champion only.
ARENA_TEAMS=octo,synthify,berts,mdeberta
ARENA_RUN_TIMEOUT_SECONDS=900
ARENA_MAX_UPLOAD_BYTES=10485760

# TEMPORARY: show randomized mock leaderboard data instead of reading
# ARENA_RESULTS_PREFIX, since nothing has been published there yet. This
# short-circuits before the real reader, so it must be set to false the moment
# QA uploads its first results/leaderboard-*.json or the real board stays
# hidden behind preview data. See evaluation/leaderboard_api/mock_data.py.
ARENA_MOCK_LEADERBOARD=false

# A local folder of real sample documents the console can upload without a
# native file dialog -- browsers do not allow a page to choose that dialog's
# starting folder, so this is how a one-click default is actually achieved.
# Leave empty to disable the sample picker (the console falls back to a plain
# file upload). Under Docker Compose, set ARENA_SAMPLE_HOST_DIRECTORY instead
# -- the container always reads from the fixed path /samples, mounted from
# that host folder read-only. Running uvicorn directly (the dev workflow),
# set this to the real host path since there is no container in between.
ARENA_SAMPLE_DIRECTORY=
ARENA_SAMPLE_HOST_DIRECTORY=/home/marwan-abdelmoneim/Documents/Cegedim/MLOps/S3-Source-Files/HealthOne_NOVA_Unmasked

# Fallback leaderboard source when no results are published yet.
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=pii-masking-leaderboard

LEADERBOARD_ALLOWED_ORIGINS=http://localhost:5173
