# Arena deployment on the MLflow VPS, behind its existing Traefik reverse
# proxy, at https://leaderboard.mlflow.me. See README.md in this directory for
# the full operator runbook, and the root deploy/README.md for how this
# differs from the (superseded, SSH-tunnel-only) NiFi-VPS design.

# The public hostname. Must already resolve to this VPS's IP before deploying,
# or certificate issuance will fail.
LEADERBOARD_DOMAIN=leaderboard.mlflow.me

# Traefik wiring, discovered from the existing mlflow-auth-gui project's own
# working router for mlflow.me. Change only if that project's Traefik setup
# changes.
MLFLOW_TRAEFIK_NETWORK=mlflow-auth-gui_mlflow
MLFLOW_TRAEFIK_ENTRYPOINT=websecure
MLFLOW_TRAEFIK_CERTRESOLVER=letsEncrypt

# Object-storage credential for the arena. This must be a DEDICATED token, not
# the QA dataset token (read-only, scoped to Validation_Datasets/), and not
# SERVICE_TOKEN. It needs write on source/incoming/ and read on
# destination/masked/, destination/manifests/, and data/results/.
ARENA_S3_ENDPOINT_URL=https://replace-with-account-id.r2.cloudflarestorage.com
ARENA_S3_ACCESS_KEY_ID=
ARENA_S3_SECRET_ACCESS_KEY=
ARENA_S3_REGION=auto

# Where QA publishes its output. The board is built from the cross-team ranking
# documents scripts/rank_teams.py writes, flat at results/leaderboard-*.json;
# per-team reports sit beneath at results/<team>/<document-id>/<report>.json.
ARENA_RESULTS_BUCKET=data
ARENA_RESULTS_PREFIX=results

# Which of qa-automation's two independent rankings the board is built from.
# "overlapping" counts a detected span that found the entity but got its
# boundaries wrong; "exact" requires the boundaries too. QA's headline number is
# the overlapping ranking, so that is the default.
ARENA_RANKING_BASIS=overlapping
# Only consider ranking documents from this run mode. "local" documents come
# from a developer running the QA suite against locally served models, and one
# uploaded by accident must never displace a real release evaluation just by
# being newer. Leave empty to consider every mode.
ARENA_LEADERBOARD_MODE=release
# Pin one exact ranking document, e.g.
# results/leaderboard-aggregate-15docs-release.json. Empty means choose
# automatically: most documents scored first, then most recent.
ARENA_LEADERBOARD_KEY=

# qa-automation names its published ranking after the document count and mode
# alone, so each run overwrites the last and R2 keeps no previous version. The
# arena copies every ranking it sees under a content-addressed key here, which
# is what gives the board a trend line and a truthful run count. Requires
# PutObject on this prefix; a read-only credential makes it a logged no-op.
ARENA_HISTORY_PREFIX=results/history
ARENA_ARCHIVE_RANKINGS=true

# Which team the masking console masks with when the board cannot be read at
# all. Normally it follows the leaderboard's own champion instead.
ARENA_CHAMPION_FALLBACK_TEAM=berts

# Production key layout, per contracts/masking-api/v1.2 section 8.
ARENA_SOURCE_BUCKET=source
ARENA_INCOMING_PREFIX=incoming
ARENA_INCOMING_KEY_TEMPLATE={prefix}/{team}/requests/{run_id}-{filename}
ARENA_MASKED_BUCKET=destination
ARENA_MASKED_PREFIX=masked
ARENA_MANIFEST_BUCKET=
ARENA_MANIFEST_PREFIX=manifests

# Every team the API will accept an upload for; runs.py rejects any other team
# server-side. The team console (#/teams) offers all of these; the masking
# console (#/console) offers one, resolved from the leaderboard's champion.
# A team listed here that NiFi does not route, or whose model service is not
# running, produces a run that times out rather than one that fails fast.
ARENA_TEAMS=octo,synthify,berts
ARENA_RUN_TIMEOUT_SECONDS=900
ARENA_MAX_UPLOAD_BYTES=10485760

# Shows randomized preview data until QA publishes real results. This
# short-circuits before the real reader, so it must be set to false the moment
# data/results/ holds a leaderboard-*.json or the real board stays hidden.
# See evaluation/leaderboard_api/mock_data.py.
ARENA_MOCK_LEADERBOARD=false

# Synthetic sample documents the console offers as one-click uploads, baked
# into the arena-api image. Set empty to disable the picker; point at a
# mounted host folder to offer different documents.
ARENA_SAMPLE_DIRECTORY=/app/samples
