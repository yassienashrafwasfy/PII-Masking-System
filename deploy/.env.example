# Copy to VPS_DEPLOY_DIR/.env, replace every placeholder, then chmod 600.
SERVICE_TOKEN=replace-with-a-long-random-secret
ENABLED_TEAMS=octo,synthify,berts
ACCELERATOR=cpu

# Visual PDF redaction. PDF_REDACTION_STYLE: "invisible" (matches the source
# glyph exactly, no visible box) or a visible box style, "clinical_soft" /
# "bold_chips". PDF_REDACTION_MODE: "pseudonymize" (box shows the fitted
# pseudonym) or "detect" (box shows the entity-type abbreviation, plus the
# model confidence as a percent when one exists); detect requires a visible
# style. Applies to all model-service teams.
PDF_REDACTION_STYLE=bold_chips
PDF_REDACTION_MODE=detect

# Let a visible redaction box take the width it needs from the rest of its
# line, moving what follows to the right. On by default; without it a box is
# capped at whatever its neighbour left, and a two-digit slot shrank
# "AGE 97%" until it truncated to "A...". Set to "off" to keep the source
# layout untouched and accept the truncation. Ignored by the invisible style.
PDF_CHIP_REFLOW=on
MODEL_ID_SHAPE_GATE=on

# Stamp the per-language detection scores on a masked PDF's first page, so a
# reviewer can tell a detected locale from the nl_BE fallback. On by default;
# set to "off" for a release where the overlay would be noise.
PDF_LOCALE_BADGE=on

# Read image-bearing PDF pages with OCR instead of refusing them. Off in the
# code (ADR 003), but on in this deployment: the production compose file
# defaults it on so that an existing .env without this line still gets OCR,
# rather than losing it silently. Set it to "off" to opt out.
# On requires OCR_MODEL_DIR below: the
# artifacts are staged on the host and mounted read-only at /models/ocr, the
# same way every other model artifact reaches production.
PDF_OCR=on

# Log level for the model services. Their own log lines carry labels, counts
# and page numbers only -- never document text -- so INFO is safe to run in
# production. "WARNING" quiets the per-request lines without losing failures.
LOG_LEVEL=INFO

# Digests of the staged OCR artifacts, verified by deploy-gateway.sh preflight
# before any image is pulled, and again by the engine as it loads. They are
# pinned in deploy/compose.yml already; override here only to roll to a
# re-exported artifact.
# They are what catches a tree staged from a checkout that skipped Git LFS
# smudge: a pointer file is 130 bytes of text where a model should be, and
# every existence check in the chain counts it as present.
OCR_DET_SHA256=049d5107f028a88efb9c96857ab72af847f0be7aeb413285669a84cf00b8f973
OCR_REC_SHA256=14a9e7d184b186fe9c0551737e0bfe53d0a3afee97806a0eeafc6565fc732a1d
OCR_CHARSET_SHA256=b5f2bfe2bdd9448429e3e82b51c789775d9b42f2403d082b00662eb77e401c5d

# Which organisation-name pool the surrogate router draws from: "medical"
# (the default) or "general". An English document with "general" falls back
# to a seeded Faker company name, since English carries a medical pool only.
ORGANIZATION_SURROGATE_POOL=medical

# ---------------------------------------------------------------------------
# Tuning knobs, shared by every model service. Each line below is commented out
# on purpose: unset means the value in deploy/compose.yml applies, and that
# default is asserted equal to the code default in
# masking_engine/app/core/config.py. Uncommenting one pins it here forever,
# including across a release that moves the code default, so uncomment only the
# knob you actually mean to hold still.

# Detection sensitivity. CONFIDENCE_THRESHOLD is the global floor a detection
# must clear. ENTITY_CONFIDENCE_THRESHOLDS overrides it per label, written as
# LABEL:VALUE,LABEL:VALUE; an entry replaces that label's shipped floor, and
# ORGANIZATION_NAME ships at 0.1 whether or not this is set.
# STRUCTURED_FIELD_THRESHOLD applies to CSV cells and JSON values, which carry
# a lower bar than prose because a lone field is far likelier to be an
# identifier than the same word in a sentence.
# Lowering a floor raises recall and costs precision, so a change here belongs
# with an evaluation run rather than with a restart.
# CONFIDENCE_THRESHOLD=0.3
# ENTITY_CONFIDENCE_THRESHOLDS=
# STRUCTURED_FIELD_THRESHOLD=0.5

# Load and body limits. MAX_CONCURRENT_MASKS bounds simultaneous masking work
# per model service; a request arriving with every slot busy gets 429 with
# Retry-After rather than queueing past the caller's read timeout. The two byte
# caps are deliberately equal, so the service masks everything it accepts --
# lower them together, or a body can be accepted and then refused by the model.
# A full 10 MiB body measured 2.4 GiB peak RSS and 107 minutes on 16 cores.
# MAX_CONCURRENT_MASKS=2
# MAX_UPLOAD_SIZE_BYTES=10485760
# MAX_MODEL_INPUT_BYTES=10485760

# Inference window, in tokens, and the overlap between consecutive windows.
# The stride must stay below the window or the service refuses to start. A
# narrow overlap leaves periodic gaps at window edges: on a 64 KiB document, 64
# tokens leaked 32 of 1598 names and 128 leaked 16, while 192 leaked none.
# Change the pair together.
# MAX_MODEL_TOKENS=510
# MODEL_STRIDE_TOKENS=192

# OCR bounds. These apply only when PDF_OCR=on, and they are the difference
# between an affordable fallback and an unbounded one. PDF_OCR_MAX_PIXELS caps
# the long edge of anything handed to OCR and is what actually protects memory:
# a page box need not match the image drawn on it, and one real sample declares
# 1861x2631pt for a 2481x3508px scan, where a fixed 300 DPI would allocate
# 255 MB for a single page. PDF_OCR_MIN_BLOCK_POINTS skips rules, bullets and
# letterhead icons, which cost more to rasterise than they can return.
# PDF_OCR_DPI=200
# PDF_OCR_MAX_PIXELS=2048
# PDF_OCR_MIN_BLOCK_POINTS=16

# OCR refusal thresholds. PDF_OCR_MIN_BOX_FILL refuses a page whose text boxes
# are too slanted for axis-aligned redaction, rather than placing boxes beside
# the words; deskew is an explicit non-goal and this keeps it a visible one.
# PDF_OCR_MAX_LINES refuses a page rather than reading part of it, because
# truncating to the best N would drop the least confident boxes, which are the
# likeliest to be carrying something worth masking.
# PDF_OCR_MIN_LINE_CONFIDENCE should stay 0: a dropped line is a line whose
# pixels stay on the page and whose text never reaches the detector, which is a
# silent leak rather than a quality trade. The knob exists to measure with.
# PDF_OCR_MIN_BOX_FILL=0.55
# PDF_OCR_MAX_LINES=400
# PDF_OCR_MIN_LINE_CONFIDENCE=0.0

# OCR thread count. Pinned on purpose: ONNX Runtime splits some reductions
# across threads, so the count changes float accumulation order and can flip a
# near-tie argmax -- one different character, and the masked bytes differ.
# Byte-reproducibility is what lets NiFi replay an idempotency key against an
# unchanged result, so raise this only for a deployment that does not rely on
# replay, and never to a value that varies with the host or its cgroup.
# OCR_INTRA_OP_THREADS=4

# Threads for one masking inference. Leave empty for half the cores the
# container may use. The default was benchmarked on a 16-core host; a
# different host size is the reason this is settable at all.
# MODEL_INTRA_OP_THREADS=

# Reported service identity. These reach /version and the masking response
# headers. SERVICE_NAME is shared by all three teams rather than set per team,
# so that overriding it cannot give one team a different reported identity from
# the rest; the release fields (SERVICE_RELEASE, GIT_SHA, IMAGE_DIGEST) are
# injected by the deploy job and are not settable here.
# APP_NAME=PII Masking Service
# APP_VERSION=1.0.0
# SERVICE_NAME=octo-pii-masker

# Private host/container ingress. Resolve the host-gateway address used by the
# NiFi container and ensure it is assigned to a Docker bridge on the VPS.
NIFI_DOCKER_BRIDGE_IP=172.18.0.1
PRIVATE_GATEWAY_PORT=18080
NGINX_SERVER_FILE=/etc/nginx/conf.d/pii-masking-gateway.conf
NGINX_CONTROL_HELPER=/usr/local/sbin/pii-masking-nginx-control
# This path is migration-specific. Keep the currently active production snippet
# unless an operator separately plans and approves a path migration.
NGINX_UPSTREAM_FILE=/etc/nginx/snippets/pii-masking-gateway-upstream.inc

# Absolute host directories containing the immutable model artifacts.
# OCR_MODEL_DIR is required only when PDF_OCR=on; leave it unset otherwise.
OCR_MODEL_DIR=/srv/pii-models/releases/replace-with-release-sha/ocr
OCTO_MODEL_DIR=/srv/pii-models/octo
SYNTHIFY_MODEL_DIR=/srv/pii-models/synthify
MODEL_RELEASES_ROOT=/srv/pii-models/releases
BERTS_MODEL_DIR=/srv/pii-models/releases/replace-with-release-sha/berts

# Automated model staging. The helper is root-owned and reachable only through
# the sudoers grant in /etc/sudoers.d/pii-masking-model-stage, which enumerates
# every accepted argument literally. The remote URL is baked into the helper at
# install time on purpose: taking it from the caller would let the deployment
# user point root's authenticated clone at another host.
MODEL_STAGE_HELPER=/usr/local/sbin/pii-masking-model-stage
MODEL_STAGE_REMOTE_URL=https://gitlab.com/internshipjuly2026/full-pii-data-masking.git
# Defaults to MODEL_RELEASES_ROOT/.staging-work. Keep it on the same filesystem
# as the releases root so staging finishes with an atomic rename and identical
# checkpoints can be hardlinked instead of refetched.
MODEL_WORK_ROOT=/srv/pii-models/releases/.staging-work
# Refuse to start a fetch that would leave less than this much free (5 GiB).
MODEL_STAGE_MIN_FREE_BYTES=5368709120

# Immutable model identities exposed by /version and masking response headers.
#
# Mind the two conventions -- they are not interchangeable, and mixing them up
# fails in a way that is hard to read from outside. `*_SHA256` keys take a bare
# 64-character hex digest with no prefix: config.py's `_digest()` rejects
# anything else, and the resulting ValueError surfaces only as a generic HTTP
# 422. `*_VERSION` and `*_DIGEST` keys take the `sha256:`-prefixed form instead,
# except BERTS_MODEL_VERSION, which is a bare 40-character upstream git
# revision. Prefer letting CI derive these from teams/<team>/onnx/manifest.json
# rather than typing them by hand.
OCTO_MODEL_NAME=octo-pii-masker
OCTO_MODEL_VERSION=sha256:21b0e69d83e992751c6e1420e74e17f6bb8f5765d0259651a62dd55d85a09236
OCTO_ONNX_MODEL_SHA256=21b0e69d83e992751c6e1420e74e17f6bb8f5765d0259651a62dd55d85a09236
SYNTHIFY_MODEL_NAME=synthify-gliner-belgian-pii-ner
SYNTHIFY_MODEL_VERSION=sha256:8a6baba537c4a00d518586a2b56f62547259f12685b9b1be9b6cfc91fa44dd45
SYNTHIFY_ONNX_MODEL_DIGEST=sha256:8a6baba537c4a00d518586a2b56f62547259f12685b9b1be9b6cfc91fa44dd45
# Berts stages three int8 checkpoints under one BERTS_MODEL_DIR -- onnx/ for
# Dutch, onnx-en/ for English, onnx-fr/ for French -- and loads whichever the
# document's language resolves to. All three are hashed before promotion and
# canaried after it, so a release that stages only one is refused rather than
# discovered by the first French document. The names are pinned in
# teams/berts/runtime.py and are here only so the promotion gate can assert
# what was approved.
BERTS_MODEL_NAME=berts-pii-medroberta-nl-int8
BERTS_MODEL_VERSION=07f18eb53e127ed34aa77a64e1e15f24ea622be8
BERTS_ONNX_MODEL_SHA256=e6ebd6471a5fd5b8d8a5e044ba9d3aa4395ec96a35c0f4c8feb803341cb8e292
BERTS_MODEL_NAME_EN=berts-pii-bert-en-int8
BERTS_MODEL_VERSION_EN=45f397a28f3efc462ec89552a7b8de574f3f61dc
BERTS_ONNX_MODEL_SHA256_EN=c317162cbc72aee06a4ffd8a903c7b645759da6e0ee2e4b90905bcd75b35f8cd
BERTS_MODEL_NAME_FR=berts-pii-camembert-bio-fr-int8
BERTS_MODEL_VERSION_FR=162c057100bb174252303bb350df4c47296ea5bd
BERTS_ONNX_MODEL_SHA256_FR=2b1af7af5f455b5f623b13d0669c8085e7dd0aa20dd0156bd6d28e4cee4d12c4
# The rollback for per-language routing. `off` sends every document to the
# Dutch checkpoint, restoring the single-model behaviour that predates the
# other two, and stops the promotion gate requiring the English and French
# artifacts to be staged. Back a bad checkpoint out with this rather than
# waiting for a release to remove it from the table.
BERTS_LANGUAGE_ROUTING=on
# Measured warm runtime RSS, not ONNX file size. Required for BERTS on hosts <16 GiB.
#
# Re-measure this before enabling Berts: it now holds up to three encoders at
# once rather than one. They load lazily -- a deployment that only ever sees
# Dutch documents never loads the other two -- so this must record the
# ceiling, with all three warm, not the figure a Dutch-only soak produces.
BERTS_WARM_RSS_MIB=replace-with-approved-warm-rss-measurement

# Synchronous runtime behavior. The model services serialize inference per team,
# while the threaded gateway can serve Octo, Synthify, Berts, and health probes together.
REQUEST_TIMEOUT_SECONDS=6600
GATEWAY_WEB_THREADS=8
MODEL_SERVICE_WEB_THREADS=2
MAX_CONCURRENT_REQUESTS_PER_TEAM=1
MODEL_IDLE_TIMEOUT_SECONDS=0

# Deployment behavior. Both complete slots are warmed before the memory gate.
NGINX_SWITCH_WAIT_SECONDS=30
DRAIN_MAX_SECONDS=6600
DRAIN_POLL_SECONDS=5
MIN_AVAILABLE_MEMORY_PERCENT=5
VERIFY_MAX_SECONDS=900

# Optional masking audit publishing to the R2 "logs" bucket. Leave both empty
# to disable; the model services then log `audit_upload_disabled` and never open
# a socket. The bucket and endpoint are hardcoded in the model service, so only
# the credentials belong here. These must live in this file rather than in
# GitLab CI/CD variables: the deploy jobs pass only image references over SSH,
# so container environment comes from this file alone.
PROD_LOGS_S3_ACCESS_KEY=
PROD_LOGS_S3_SECRET_KEY=

# Optional PII-free runtime alerting. Leave empty to log structured alert JSON to
# stderr/systemd-journald; store a real webhook only in this chmod-600 file.
ALERT_WEBHOOK_URL=
WATCHDOG_REPAIR_COOLDOWN_SECONDS=600
WATCHDOG_REPAIR_WAIT_SECONDS=10
