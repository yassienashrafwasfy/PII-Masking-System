# Render this file with install-vps.sh. It is loaded inside Nginx's http block.
include @NGINX_UPSTREAM_FILE@;

log_format pii_masking_safe '$remote_addr $request_method $uri $status '
                            '$body_bytes_sent $request_time';

server {
    listen 127.0.0.1:@PRIVATE_GATEWAY_PORT@;
    listen @NIFI_DOCKER_BRIDGE_IP@:@PRIVATE_GATEWAY_PORT@;
    server_name _;

    access_log /var/log/nginx/pii-masking-access.log pii_masking_safe;
    error_log /var/log/nginx/pii-masking-error.log warn;

    client_max_body_size 10m;
    client_body_timeout 6600s;

    location / {
        proxy_pass http://masking_gateway;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto http;
        proxy_connect_timeout 5s;
        proxy_read_timeout 6600s;
        proxy_send_timeout 6600s;
        proxy_request_buffering off;
        proxy_buffering off;
    }
}
