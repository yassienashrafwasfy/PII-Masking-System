# Set this to a long random value before starting the demo.
SERVICE_TOKEN=

# R2 credentials for the per-request masking audit object each model service
# writes to the logs bucket. Optional: leave both blank and no audit object is
# written -- the service logs audit_upload_disabled and masks as normal. Only
# fill them in when you actually want the demo's requests recorded there.
PROD_LOGS_S3_ACCESS_KEY=
PROD_LOGS_S3_SECRET_KEY=
